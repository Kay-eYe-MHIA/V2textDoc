# Choose "anthropic" (cloud, costs per request) or "ollama" (local, free, offline)
LLM_PROVIDER=anthropic

# Needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Needed when LLM_PROVIDER=ollama — Ollama must be running on the host machine
# (install from ollama.com, then `ollama pull llama3.1:8b`).
# host.docker.internal lets the container reach the host; leave as-is on Windows/Mac.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Speech-to-text (Whisper, runs locally in the backend container, CPU by default).
# Model size: tiny < base < small < medium < large-v3 — bigger = more accurate but
# slower/more RAM. First use downloads the model automatically (needs internet once).
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# "en" by default; set to "ms" for Malay, or leave blank to auto-detect language
# (useful for mixed English/Malay clinical speech).
WHISPER_LANGUAGE=en
